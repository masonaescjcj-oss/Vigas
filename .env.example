# --- Database (local: `pnpm db:up` starts Postgres on 5433) ---
DATABASE_URL=postgres://vigas:vigas@localhost:5433/vigas
TEST_DATABASE_URL=postgres://vigas:vigas@localhost:5433/vigas_test

# --- Gateway (apps/gateway) ---
GATEWAY_PORT=8787
# Shared secret the web app uses to call the gateway on behalf of a signed-in user (Chat, Arena).
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string
# Requests per minute per API key.
RATE_LIMIT_RPM=120
# Provider keys. A model whose provider has no key is served by the mock provider only when
# MOCK_PROVIDERS=true (local dev and tests).
MOCK_PROVIDERS=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini API (native REST via x-goog-api-key: supports BOTH legacy `AIza...` and 2026 `AQ....` keys!)
# Free-Tier multi-key pool defaults strictly to Gemini 4 Hydrogen + `sticky` strategy for coding Prompt Cache hits.
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
GOOGLE_KEY_STRATEGY=sticky
GOOGLE_ALLOWED_MODELS=google/gemini-4-hydrogen,google/gemini-4-hydrogen:free
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
XIAOMI_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
# Upstream Relay Pool #1 (Anthropic Messages protocol; masked as `vigas-edge` to callers)
# Supports single key (`SEVENAPI_API_KEY`) or multi-key rotation pool (`SEVENAPI_API_KEYS=k1,k2,...`).
SEVENAPI_BASE_URL=https://7api.st/v1
SEVENAPI_API_KEY=
# SEVENAPI_API_KEYS=
# SEVENAPI_KEY_STRATEGY=round_robin
# SEVENAPI_KEY_BUDGET_USD=100
# Upstream Pool #2: You.com Agents API (multi-key pool, e.g. 10 × $100 keys)
# Strategies: round_robin | random | sequential | least_used
YOU_BASE_URL=https://api.you.com
YOU_API_KEYS=
YOU_KEY_STRATEGY=round_robin
YOU_KEY_BUDGET_USD=100
# Restrict free welcome promo credits (before first top-up) to You.com & Hydrogen models; set `all` to disable restriction.
PROMO_ONLY_MODEL_PREFIXES=you/,google/gemini-4-hydrogen
# Mask all upstream provider slugs in production responses & errors
HIDE_UPSTREAM_PROVIDERS=true
FIRST_BYTE_TIMEOUT_MS=90000
# Optional: attach 10-20+ additional dynamic upstream pools via JSON array or PROVIDER_<NAME>_* vars
# UPSTREAM_PROVIDERS=[{"slug":"pool2","kind":"openai","baseUrl":"https://...","apiKeys":["k1","k2"],"keyStrategy":"random","keyBudgetUsd":100}]
# PROVIDER_POOL2_KIND=openai
# PROVIDER_POOL2_BASE_URL=
# PROVIDER_POOL2_API_KEYS=
# PROVIDER_POOL2_KEY_STRATEGY=round_robin
# PROVIDER_POOL2_KEY_BUDGET_USD=100

# --- Web (apps/web) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8787
# Welcome promo credit (USD) granted once to every brand-new signup (default $5 for You.com models; 0 to disable).
SIGNUP_BONUS_USD=5
# Comma-separated admin emails allowed into /admin (in addition to users.role = 'admin' in Postgres).
ADMIN_EMAILS=
# Optional 32+ char secret for AES-256-GCM encryption of upstream API keys stored via /admin/providers (falls back to INTERNAL_SERVICE_TOKEN).
# UPSTREAM_KEYS_SECRET=
# Top-up fee in basis points after the first $5 of lifetime top-ups (500 = 5%).
TOPUP_FEE_BPS=500
# Payment provider: "avexpay" for AvexPay.net (Crypto + Telegram Stars), or "test" for dev instant credits.
PAYMENT_PROVIDER=test
# AvexPay.net API v1 (https://avexpay.net/docs)
AVEXPAY_API_KEY=
AVEXPAY_ORG_ID=
AVEXPAY_WEBHOOK_SECRET=
AVEXPAY_BASE_URL=https://api.avexpay.net/v1
# Supabase Auth SSO shared across vigas.app and vigas.app/chat
NEXT_PUBLIC_SUPABASE_URL=https://jasgepmskcsyvqoesocc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Arena battles per user per day (paid by the platform).
ARENA_DAILY_LIMIT=30
# Content & launch controls:
# Set VIGAS_DEMO_NEWS=1 to display built-in prototype sample stories in DB-less mode (off by default).
# Set VIGAS_SEED_DEMO_NEWS=1 when running `pnpm db:seed` if you want prototype sample stories seeded into Postgres (off by default).
# Set VIGAS_PREVIEW_BANNER=1 to show the top sample-data notice ribbon in DB-less mode.
VIGAS_DEMO_NEWS=0
VIGAS_SEED_DEMO_NEWS=0
VIGAS_PREVIEW_BANNER=0

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_SITE_URL=https://vigas.app
EXPO_PUBLIC_SUPABASE_URL=https://jasgepmskcsyvqoesocc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
