# --- Database (local: `pnpm db:up` starts Postgres on 5433) ---
DATABASE_URL=postgres://vigas:vigas@localhost:5433/vigas
TEST_DATABASE_URL=postgres://vigas:vigas@localhost:5433/vigas_test

# --- Gateway (apps/gateway) ---
GATEWAY_PORT=8787
# Shared secret the web app uses to call the gateway on behalf of a signed-in user (Chat, Arena).
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string
# Requests per minute per API key.
RATE_LIMIT_RPM=120
# Provider keys. A model whose provider has no key is served by the mock provider only when
# MOCK_PROVIDERS=true (local dev and tests).
MOCK_PROVIDERS=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
XIAOMI_API_KEY=
NVIDIA_API_KEY=

# --- Web (apps/web) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8787
# Top-up fee in basis points after the first $5 of lifetime top-ups (500 = 5%).
TOPUP_FEE_BPS=500
# Payment provider: "test" adds credits immediately (dev only).
PAYMENT_PROVIDER=test
# Arena battles per user per day (paid by the platform).
ARENA_DAILY_LIMIT=30

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
