# Copy to .env.local for local runs. See the repo-root .env.example for every variable.

# Postgres (local: `pnpm db:up` starts it on port 5433).
DATABASE_URL=postgres://vigas:vigas@localhost:5433/vigas

# Public origin of the site, used for canonical URLs, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI-compatible gateway (apps/gateway) used by Vigas Chat and Arena.
GATEWAY_URL=http://localhost:8787
# Shared secret the web app sends to the gateway. Must match the gateway's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string

# Top-up fee in basis points after the first $5 of lifetime top-ups (500 = 5%).
TOPUP_FEE_BPS=500
# "test" adds credits immediately (development only). Any other value returns 501 from /api/app/wallet/topup.
PAYMENT_PROVIDER=test

# Arena battles per user per UTC day (paid by the platform).
ARENA_DAILY_LIMIT=30
# Optional: account that pays for Arena battles. Defaults to the signed-in user's own account.
# ARENA_BILLING_ACCOUNT_ID=
