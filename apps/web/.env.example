# Copy to .env.local for local runs. See the repo-root .env.example for every variable.

# Postgres (local: `pnpm db:up` starts it on port 5433).
DATABASE_URL=postgres://vigas:vigas@localhost:5433/vigas

# Public origin of the site, used for canonical URLs, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI-compatible gateway (apps/gateway) used by Vigas Chat and Arena.
GATEWAY_URL=http://localhost:8787
# Shared secret the web app sends to the gateway. Must match the gateway's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string

# Top-up fee in basis points after the first $5 of lifetime top-ups (500 = 5%).
TOPUP_FEE_BPS=500
# "avexpay" for AvexPay.net checkout (or "test" in dev to add credits immediately).
PAYMENT_PROVIDER=test
AVEXPAY_API_KEY=
AVEXPAY_ORG_ID=
AVEXPAY_WEBHOOK_SECRET=
AVEXPAY_BASE_URL=https://api.avexpay.net/v1
# Shared Supabase Auth project for unified sign-in with vigas.app/chat
NEXT_PUBLIC_SUPABASE_URL=https://jasgepmskcsyvqoesocc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Arena battles per user per UTC day (paid by the platform).
ARENA_DAILY_LIMIT=30
# Optional: account that pays for Arena battles. Defaults to the signed-in user's own account.
# ARENA_BILLING_ACCOUNT_ID=

# Launch & editorial controls:
# Set VIGAS_DEMO_NEWS=1 to show prototype stories when DATABASE_URL is unset (off by default so search engines only see real articles).
# Set VIGAS_SEED_DEMO_NEWS=1 when running `pnpm db:seed` if you want prototype sample stories inserted (off by default).
# Set VIGAS_PREVIEW_BANNER=1 to show the top preview warning bar in DB-less mode.
VIGAS_DEMO_NEWS=0
VIGAS_SEED_DEMO_NEWS=0
VIGAS_PREVIEW_BANNER=0
